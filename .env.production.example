# ==============================================================================
# IEEE Menoufia Student Branch Portal — Production Environment Variables
# Copy this file to .env.production on your VPS:
#   cp .env.production.example .env.production
# Generate secure random keys where indicated using: openssl rand -base64 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & PERSISTENCE CREDENTIALS
# ------------------------------------------------------------------------------
POSTGRES_DB=ieee_portal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_postgres_password

# Redis auth password (shared between DB 0 and DB 1)
REDIS_PASSWORD=replace_with_strong_redis_password

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY TOKENS
# ------------------------------------------------------------------------------
# Main user JWT secret used by Gateway / IAM
JWT_SECRET=replace_with_strong_jwt_secret_48_chars_or_more

# Shared secret between Gateway and internal microservices
GATEWAY_SHARED_SECRET=replace_with_strong_gateway_shared_secret

# HMAC key used by Gateway to sign user claims forwarded in X-User-* headers
AUTH_CLAIMS_HMAC_SECRET=replace_with_strong_claims_hmac_secret

# Service-to-service bearer token for IAM / Gateway endpoints
IAM_SERVICE_AUTH_TOKEN=replace_with_strong_iam_service_auth_token

# Service-to-service bearer token for Email Service endpoints
EMAIL_SERVICE_AUTH_TOKEN=replace_with_strong_email_service_auth_token

# Google OAuth2 Client ID for Google Sign-In / Registration
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. CORS & FRONTEND DOMAINS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (e.g. Vercel deployment URLs)
CORS_ORIGIN=https://portal.ieeemsb.org,https://ieee-portal.vercel.app

# Public frontend URL used for email verification / password reset links
FRONTEND_URL=https://portal.ieeemsb.org

# ------------------------------------------------------------------------------
# 4. CLOUDINARY FILE SERVICE
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. MAILJET TRANSACTIONAL EMAIL SERVICE
# ------------------------------------------------------------------------------
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_API_SECRET=your_mailjet_api_secret
EMAIL_DEFAULT_FROM=noreply@ieeemsb.org
