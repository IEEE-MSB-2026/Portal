PORT=5080
NODE_ENV=development
GATEWAY_SHARED_SECRET=dev-gateway-secret-change-in-prod

# Cloudinary Free Plan Credentials (leave blank for local mock fallback)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=ieee_portal

# Credit-Saving Constraints
MAX_IMAGE_SIZE_MB=5
MAX_DOC_SIZE_MB=15
MAX_VIDEO_SIZE_MB=25
SIGNATURE_EXPIRY_SECONDS=3600
ENABLE_LOCAL_FALLBACK=true
