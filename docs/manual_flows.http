POST {{emailUrl}}/email/send
Content-Type: application/json
x-service-token: 2nUcG0xRi652tH8Y1RW/lsA2+BOvli2RvbNSfeMwl1Q=

{
  "to": "test-member@ieee.local",
  "subject": "Welcome to IEEE Menoufia Student Branch!",
